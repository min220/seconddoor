{
  "name": "Broker",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Broker's full name"
    },
    "company": {
      "type": "string",
      "description": "Brokerage company name"
    },
    "license_number": {
      "type": "string",
      "description": "Real estate license number"
    },
    "phone": {
      "type": "string",
      "description": "Contact phone number"
    },
    "email": {
      "type": "string",
      "description": "Contact email"
    },
    "bio": {
      "type": "string",
      "description": "Professional biography"
    },
    "specializations": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "evictions",
          "bankruptcy",
          "poor_credit",
          "no_credit",
          "criminal_background",
          "self_employed",
          "section_8",
          "first_time_renters"
        ]
      },
      "description": "Areas of specialization"
    },
    "areas_served": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Geographic areas served"
    },
    "years_experience": {
      "type": "number",
      "description": "Years of experience"
    },
    "success_rate": {
      "type": "number",
      "description": "Success rate percentage"
    },
    "profile_image": {
      "type": "string",
      "description": "Profile photo URL"
    },
    "rating": {
      "type": "number",
      "description": "Average rating"
    },
    "review_count": {
      "type": "number",
      "description": "Number of reviews"
    },
    "is_verified": {
      "type": "boolean",
      "default": false,
      "description": "Whether broker is verified"
    }
  },
  "required": [
    "name",
    "company",
    "phone",
    "email",
    "specializations",
    "areas_served"
  ]
}