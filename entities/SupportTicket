{
  "name": "SupportTicket",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the person submitting the ticket"
    },
    "email": {
      "type": "string",
      "description": "Email of the person submitting the ticket"
    },
    "subject": {
      "type": "string",
      "description": "Subject of the inquiry"
    },
    "message": {
      "type": "string",
      "description": "The user's question or message"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "in_progress",
        "resolved"
      ],
      "default": "new",
      "description": "Status of the support ticket"
    }
  },
  "required": [
    "name",
    "email",
    "subject",
    "message"
  ],
  "x-base44-security": {
    "read": {
      "role": {
        "in": [
          "admin"
        ]
      }
    },
    "create": {
      "public": true
    },
    "update": {
      "role": {
        "in": [
          "admin"
        ]
      }
    },
    "delete": {
      "role": {
        "in": [
          "admin"
        ]
      }
    }
  }
}